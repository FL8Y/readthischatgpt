{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic-tree.schema.json",
  "title": "Topic tree",
  "description": "Subjects > topics > sub-topics. Mirrors the repo's PNLE deck hierarchy; ids are stable slugs of the path.",
  "type": "object",
  "required": ["version", "source", "subjects"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "source": { "type": "string" },
    "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "name", "depth", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$" },
        "name": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 1 },
        "np": { "type": "array", "items": { "enum": ["NP1", "NP2", "NP3", "NP4", "NP5", "CROSS_CUTTING"] }, "description": "PROVISIONAL Nursing Practice mapping (verify against the official TOS)." },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
